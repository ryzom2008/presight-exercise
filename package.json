{
  "name": "presight-exercise",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "db:seed": "yarn workspace presight-server db:seed",
    "test": "yarn workspace presight-server test",
    "dev:client": "yarn workspace presight-client dev",
    "dev:server": "yarn workspace presight-server dev",
    "build": "yarn workspace presight-client build && yarn workspace presight-server build",
    "typecheck": "yarn workspace presight-client typecheck && yarn workspace presight-server typecheck",
    "start": "yarn workspace presight-server start",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
